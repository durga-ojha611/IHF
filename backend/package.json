{
  "name": "ihf-backend",
  "version": "1.0.0",
  "description": "High-Ticket Luxury Custom Curtains & Draperies E-Commerce REST API Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seeder.js",
    "seed:destroy": "node src/seed/seeder.js --destroy --force-reset",
    "import:shopify": "node src/scripts/import-shopify-catalog.js",
    "test": "node test/runApiTests.js"
  },
  "keywords": [
    "ecommerce",
    "custom-curtains",
    "express",
    "mongodb",
    "stripe",
    "rest-api",
    "esm"
  ],
  "author": "IHF Luxury Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "firebase": "^12.19.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.3",
    "morgan": "^1.10.1",
    "nodemailer": "^10.0.13",
    "slugify": "^1.6.6",
    "stripe": "^18.1.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
